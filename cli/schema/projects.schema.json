{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yadral.com/yadra/projects.schema.json",
  "title": "Yadra projects registry",
  "type": "object",
  "required": ["version", "projects"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "current": { "type": ["string", "null"] },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kslProjectHome"],
        "properties": {
          "kslProjectHome": { "type": "string" },
          "projectHome": { "type": "string" },
          "yadraProjectHome": { "type": "string" },
          "rootProjectFile": { "type": "string" },
          "projectId": { "type": "string" },
          "llm": {
            "type": "object",
            "properties": {
              "profile": { "type": "string" },
              "model": { "type": "string" }
            },
            "additionalProperties": false
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
