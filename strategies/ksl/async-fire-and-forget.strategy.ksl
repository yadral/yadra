strategy_skeleton 1.0

strategy "AsyncRequest-FireAndForget" {
  id = "async-fire-and-forget"
  family = "async"
  implementation_language = "project"

  intent {
    """
    Découpler l'émission d'un effet ou d'une commande de toute attente de réponse
    métier : acquittement minimal, traitement en arrière-plan.
    """
  }

  applicability {
    signals = ["fire-and-forget", "no reply", "enqueue", "event emit", "background"]
  }

  participants {
    participant "Client" {
      kind = "consumer"
      responsibility = "Déclenche l'action ; n'attend pas le résultat métier (au plus un ack technique)."
    }
    participant "FireAndForgetGateway" {
      kind = "primary_adapter"
      responsibility = "Valide, mappe en commande/événement, publie ou enqueue, ack rapide."
    }
    participant "OutboundChannel" {
      kind = "port"
      responsibility = "Queue, topic, ou bus interne — livraison at-least-once sauf spec contraire."
    }
    participant "BackgroundHandler" {
      kind = "processor"
      responsibility = "Consomme et exécute ; idempotence si redelivery."
    }
  }

  relations {
    relation "Client" -> "FireAndForgetGateway" { type = "invokes" }
    relation "FireAndForgetGateway" -> "OutboundChannel" { type = "publishes" }
    relation "BackgroundHandler" -> "OutboundChannel" { type = "consumes" }
  }

  algorithm {
    step 1 { action = "Gateway valide la requête et construit le message/commande." }
    step 2 { action = "Publication sur OutboundChannel ; réponse ack (ex. 202/204) sans corps métier." }
    step 3 { action = "BackgroundHandler traite de façon indépendante du cycle HTTP client." }
  }

  generation {
    required = ["FireAndForgetGateway", "OutboundChannel", "BackgroundHandler"]
    optional = ["dedup key", "dead-letter", "metrics on failure"]
    forbidden = [
      "API qui bloque jusqu'à la fin du traitement sans nommer une autre variante async",
      "Client obligé de poller un résultat alors que la spec dit fire-and-forget",
      "Perte silencieuse sans DLQ ou log si OutboundChannel échoue",
      "Handler sans idempotence quand le canal est at-least-once"
    ]
  }

  tests {
    assertion "fast-ack" {
      verifies = "Gateway répond avant la fin du BackgroundHandler."
    }
    assertion "delivery" {
      verifies = "Message publié est traité une fois (ou idempotent sur redelivery)."
    }
  }

  composition {
    compatible = ["Hexagonal", "Command", "TransactionalOutbox", "Observer"]
  }

  examples {
    java {
      """
// OrderPaid relay notification — ack HTTP immédiat, traitement Kafka async

package <basePackage>.infrastructure.primary.rest.notification;

@RestController
@RequiredArgsConstructor
public class OrderNotificationController {
  private final OutboundChannel outboundChannel;

  @PostMapping("/internal/order-paid/notify")
  public ResponseEntity<Void> enqueueCustomerEmail(@RequestBody OrderPaidNotificationRequest body) {
    outboundChannel.publish(new SendOrderReceiptCommand(body.orderId(), body.customerEmail()));
    return ResponseEntity.accepted().build();
  }
}

@Component
class SendOrderReceiptHandler {
  @KafkaListener(topics = "notifications.order-receipt")
  public void handle(SendOrderReceiptCommand command) {
    emailService.sendReceipt(command.orderId(), command.customerEmail());
  }
}
      """
    }
  }
}
